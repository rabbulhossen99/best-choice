{
  "name": "gadgethome-commerce",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:api": "node --env-file-if-exists=.env --watch server/index.mjs",
    "dev:web": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "start": "node --env-file-if-exists=.env server/index.mjs",
    "db:seed": "node --env-file-if-exists=.env server/seed.mjs",
    "admin:create": "node --env-file-if-exists=.env server/create-admin.mjs",
    "admin:reset": "node --env-file-if-exists=.env server/create-admin.mjs --reset-password",
    "db:backup": "node --env-file-if-exists=.env scripts/backup.mjs",
    "format": "prettier --write src server scripts tests",
    "format:check": "prettier --check src server scripts tests",
    "test": "node --test tests/*.test.mjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@fontsource-variable/fredoka": "^5.2.0",
    "@fontsource-variable/noto-sans-bengali": "^5.2.0",
    "@fontsource-variable/plus-jakarta-sans": "^5.2.0",
    "@radix-ui/react-slot": "^1.2.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dotenv": "^18.0.5",
    "express": "^5.1.0",
    "express-rate-limit": "^8.1.0",
    "helmet": "^8.1.0",
    "lucide-react": "^0.575.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.9.0",
    "tailwind-merge": "^3.5.0",
    "tw-animate-css": "^1.3.4",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.2.1",
    "@types/node": "^24",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.2.0",
    "prettier": "^3.7.3",
    "tailwindcss": "^4.2.1",
    "typescript": "^5.8.3",
    "vite": "8.1.5"
  }
}
