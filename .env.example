PORT=3001
HOST=127.0.0.1
APP_ORIGIN=http://localhost:5173
DATABASE_PATH=./data/commerce.sqlite
UPLOAD_DIR=./uploads
# Set NODE_ENV=production and APP_ORIGIN=https://your-domain for deployment.
# Set TRUST_PROXY=1 only behind a trusted, single reverse proxy.
# No default admin password. Use pnpm admin:create (interactive).
COURIER_ENCRYPTION_KEY=replace-with-64-character-hex-key
# If this is intentionally unset on an older installation, courier settings
# can temporarily use TRACKING_ENCRYPTION_KEY below when both services shared
# the same stable AES-256-GCM key. Set a dedicated courier key for new installs.
# 64 hex characters (32 bytes) for AES-256-GCM tracking settings encryption.
# Keep this stable; changing it makes existing encrypted settings unreadable.
TRACKING_ENCRYPTION_KEY=replace-with-64-character-hex-key
